/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite emits fingerprinted build assets — cache them hard
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML should revalidate so deploys are picked up
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Asset canister wasm fetched by the app and installed into users' canisters.
# Must arrive as raw gzip bytes; gzip isn't auto-compressed, so no Content-Encoding is added.
/assetstorage.wasm.gz
  Content-Type: application/gzip
  Cache-Control: public, max-age=31536000, immutable
