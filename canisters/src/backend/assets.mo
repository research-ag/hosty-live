import Blob "mo:core/Blob";
import Principal "mo:core/Principal";
import Text "mo:core/Text";
import Error "mo:core/Error";
import Sha256 "mo:sha2/Sha256";

/// Interface of the hosty frontend canister: hosty's build of dfinity/certified-assets
/// with the cycles patch (see canisters/certified-assets/README.md).
module Assets {

  public type HeaderField = (Text, Text);
  public type Encoding = { #Identity; #Gzip; #Brotli };
  public type RulePattern = { #Exact : Text; #Subtree : Text };
  public type RedirectRule = {
    from : RulePattern;
    to : Text;
    status : Nat16;
    headers : [HeaderField];
  };
  public type Operation = {
    #CreateAsset : { key : Text; content_type : Text; headers : [HeaderField] };
    #SetAssetContent : {
      key : Text;
      encoding : Encoding;
      chunk_ids : [Nat64];
      sha256 : Blob;
      chunk_sha256 : [Blob];
    };
    #UnsetAssetContent : { key : Text; encoding : Encoding };
    #DeleteAsset : { key : Text };
    #SetAssetHeaders : { key : Text; headers : [HeaderField] };
    #SetRedirectRules : { rules : [RedirectRule] };
    #SetPreparationCanary : { canary : Blob };
  };
  /// install_code argument of the canister (`opt InitArgs`); hosty passes null.
  public type InitArgs = { governance : ?Principal; authorize : ?[Principal] };

  public type AssetCanister = actor {
    version : query () -> async { major : Nat32; minor : Nat32; patch : Nat32 };
    authorize : Principal -> async ();
    deauthorize : Principal -> async ();
    list_authorized : () -> async [Principal];
    start_sync : () -> async {
      #Started : { session_id : Nat64 };
      #Busy : { owner : Principal; idle_for_secs : Nat64 };
    };
    upload_chunks : { session_id : Nat64; chunks : [Blob] } -> async [Nat64];
    execute_operations : {
      session_id : Nat64;
      operations : [Operation];
      is_final : Bool;
    } -> async ?Blob;
    // hosty.live patch
    wallet_send : ({ canister : Principal; amount : Nat64 }) -> async ({
      #Ok;
      #Err : Text;
    });
  };

  public func getAssetActor(cid : Principal) : AssetCanister = actor (Principal.toText(cid));

  /// Replace the site with the hosty default page, using the sync protocol
  /// (start_sync -> upload_chunks -> execute_operations). Mirrors what the
  /// certified-assets sync plugin does for a directory holding only index.html.
  /// Meant for a freshly (re)installed canister, i.e. one without assets.
  public func uploadDefaultPage(cid : Principal) : async* () {
    let assets = getAssetActor(cid);
    let page = Text.encodeUtf8(getDefaultPage(cid));
    let session_id = switch (await assets.start_sync()) {
      case (#Started { session_id }) session_id;
      case (#Busy _) throw Error.reject("assets canister is busy with another sync");
    };
    let chunkIds = await assets.upload_chunks({ session_id; chunks = [page] });
    if (chunkIds.size() != 1) throw Error.reject("upload_chunks returned unexpected chunk ids");
    let sha256 = Sha256.fromBlob(#sha256, page);
    ignore await assets.execute_operations({
      session_id;
      is_final = true;
      operations = [
        #CreateAsset { key = "/index.html"; content_type = "text/html"; headers = [] },
        #SetAssetContent {
          key = "/index.html";
          encoding = #Identity;
          chunk_ids = chunkIds;
          sha256;
          chunk_sha256 = [sha256];
        },
        // clean-URL rules the sync plugin synthesizes for /index.html
        #SetRedirectRules {
          rules = [
            { from = #Exact "/"; to = "/index.html"; status = 200; headers = [] },
            { from = #Exact "/index"; to = "/"; status = 307; headers = [] },
            { from = #Exact "/index.html"; to = "/"; status = 307; headers = [] },
          ];
        },
      ];
    });
  };

  public func getDefaultPage(cid : Principal) : Text = "<!DOCTYPE html>
<html lang=\"en\">
<head>
    <meta charset=\"UTF-8\">
    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">
    <title>Hosted via hosty.live</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        .container {
            text-align: center;
            padding: 2rem;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        }
        h1 {
            font-size: 3rem;
            margin-bottom: 1rem;
            font-weight: 300;
        }
        p {
            font-size: 1.2rem;
            opacity: 0.9;
            margin-bottom: 2rem;
        }
        .canister-id {
            font-family: 'Monaco', 'Menlo', monospace;
            background: rgba(0, 0, 0, 0.2);
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-size: 0.9rem;
            word-break: break-all;
        }
    </style>
</head>
<body>
    <div class=\"container\">
        <h1>🚀 Hosted via hosty.live</h1>
        <p>Your canister is ready for deployment!</p>
        <div class=\"canister-id\">" # Principal.toText(cid) # "</div>
    </div>
</body>
</html>";

  // sha256 of HOSTY_ASSETS_MODULE (canisters/certified-assets, make release)
  public let HOSTY_ASSETS_MODULE_HASH : Blob = "\c4\2f\78\01\f1\1c\86\95\d7\4b\3d\7f\7b\58\ac\31\38\fb\b5\52\92\d3\27\3b\46\bd\7d\02\1b\94\ba\e8";
  
  public let HOSTY_ASSETS_MODULE : Blob = "\1f\8b\08\00\00\00\00\00\02\03\ec\bd\0b\60\1c\57\75\37\3e\af\dd\99\9d\d9\d9\1d\bd\df\d2\ec\ae\2c\eb\81\49\08\c1\0e\e6\51\26\6d\02\21\94\50\4a\29\6d\e3\d8\b2\ad\c4\de\38\7e\2a\2f\08\b6\92\38\60\a8\01\03\06\dc\7e\a6\88\62\88\28\0e\18\30\60\be\1a\50\12\d3\28\60\8a\5a\4c\63\c0\b4\0e\b6\13\99\38\b6\70\9c\44\21\26\f9\9f\73\ee\9d\b9\b3\da\95\76\57\e2\df\e0\af\55\e2\d9\3b\77\ee\3d\f7\bc\7e\e7\de\7b\66\76\56\ea\dd\70\93\2c\49\92\7c\48\7d\fd\12\49\5a\22\c9\9b\e0\df\c6\25\f2\26\09\fe\c1\09\1c\f0\4c\be\63\89\b2\09\ea\e0\00\95\78\dc\b8\44\dd\84\35\78\84\2a\fa\d8\b8\44\db\44\95\f4\01\b5\ec\73\e3\92\c8\26\56\cf\3e\e1\42\74\13\af\e1\05\a8\d2\37\f9\75\7e\09\2a\8d\4d\41\6d\6c\93\28\9b\9b\42\27\96\38\c1\2e\f1\d0\29\5c\4d\6e\ca\fd\83\16\9c\d2\c6\8d\1b\fd\f1\37\32\96\f9\f9\46\2e\d7\46\76\64\62\6d\64\ec\6f\e4\4c\6f\dc\14\14\36\32\81\91\1a\36\d8\48\6a\da\48\07\d2\d5\46\d2\d5\46\a2\b9\91\69\65\23\53\c6\46\ae\41\d6\75\23\31\a4\6c\7a\2f\1e\ee\40\9a\77\10\bb\32\11\a0\2e\0a\b5\d8\c8\2a\68\5c\38\62\9b\c8\46\4e\8b\68\c8\ef\95\df\bb\44\be\43\be\43\39\a8\77\ab\2b\97\5d\5c\b5\b6\6f\fd\f5\6b\d6\df\d4\bb\7a\59\df\e2\65\6b\6e\5e\dd\df\b7\5e\8a\e0\15\f3\a6\0d\37\2c\5e\df\97\ed\5b\d6\2f\e9\58\51\c3\2a\d6\ae\ba\7d\f1\f2\de\fe\de\c5\bd\6b\d7\f6\ad\5e\ce\ae\c5\82\6b\92\84\e7\f6\86\fe\de\a5\ab\fa\e6\5f\ba\78\c3\ca\77\f7\49\4a\6e\dd\0d\eb\d7\dc\2a\5d\9a\5b\b7\be\af\77\b9\f4\1a\ac\4b\04\75\b7\ae\5f\d9\df\c7\2a\b5\fe\f5\bd\6b\d9\58\95\7d\ab\6f\59\7c\4b\ef\7a\f8\b7\ea\e6\3e\36\80\51\e0\c2\b2\35\6b\6f\97\1c\ba\b0\ac\6f\7d\ff\ca\eb\57\f6\2d\67\9c\6f\e8\e3\22\25\91\ed\65\bd\ab\56\f5\ad\67\74\e4\c9\b5\44\c4\c4\da\0a\9f\fa\ea\de\9b\f8\a8\5a\7e\3d\b5\b7\a9\1e\a9\f4\ae\bf\81\0f\19\50\cf\ad\17\f4\2b\97\f5\ae\5e\b9\a1\1f\39\e9\5b\75\7d\a8\c3\a4\0b\a2\87\ed\8f\4c\76\63\8d\ed\95\1b\e0\74\75\ff\fa\35\c8\3e\d3\4b\95\b0\e4\62\2c\0a\d2\93\af\08\da\c9\d0\95\65\6b\96\f3\f6\f5\8c\67\a6\cd\65\bd\fd\7d\8b\d7\ae\ef\db\d0\e7\0f\5e\93\77\59\0c\95\7f\4d\0c\56\4b\63\df\be\6c\55\df\06\18\f3\fa\