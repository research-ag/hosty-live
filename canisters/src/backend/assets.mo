import Blob "mo:core/Blob";
import Principal "mo:core/Principal";
import Text "mo:core/Text";
import Error "mo:core/Error";
import Sha256 "mo:sha2/Sha256";

/// Interface of the hosty frontend canister: hosty's build of dfinity/certified-assets
/// with the cycles patch (see canisters/certified-assets/README.md).
module Assets {

  public type HeaderField = (Text, Text);
  public type Encoding = { #Identity; #Gzip; #Brotli };
  public type RulePattern = { #Exact : Text; #Subtree : Text };
  public type RedirectRule = {
    from : RulePattern;
    to : Text;
    status : Nat16;
    headers : [HeaderField];
  };
  public type Operation = {
    #CreateAsset : { key : Text; content_type : Text; headers : [HeaderField] };
    #SetAssetContent : {
      key : Text;
      encoding : Encoding;
      chunk_ids : [Nat64];
      sha256 : Blob;
      chunk_sha256 : [Blob];
    };
    #UnsetAssetContent : { key : Text; encoding : Encoding };
    #DeleteAsset : { key : Text };
    #SetAssetHeaders : { key : Text; headers : [HeaderField] };
    #SetRedirectRules : { rules : [RedirectRule] };
    #SetPreparationCanary : { canary : Blob };
  };
  /// install_code argument of the canister (`opt InitArgs`); hosty passes null.
  public type InitArgs = { governance : ?Principal; authorize : ?[Principal] };

  public type AssetCanister = actor {
    version : query () -> async { major : Nat32; minor : Nat32; patch : Nat32 };
    authorize : Principal -> async ();
    deauthorize : Principal -> async ();
    list_authorized : () -> async [Principal];
    start_sync : () -> async {
      #Started : { session_id : Nat64 };
      #Busy : { owner : Principal; idle_for_secs : Nat64 };
    };
    upload_chunks : { session_id : Nat64; chunks : [Blob] } -> async [Nat64];
    execute_operations : {
      session_id : Nat64;
      operations : [Operation];
      is_final : Bool;
    } -> async ?Blob;
    // hosty.live patch
    wallet_send : ({ canister : Principal; amount : Nat64 }) -> async ({
      #Ok;
      #Err : Text;
    });
  };

  public func getAssetActor(cid : Principal) : AssetCanister = actor (Principal.toText(cid));

  /// Replace the site with the hosty default page, using the sync protocol
  /// (start_sync -> upload_chunks -> execute_operations). Mirrors what the
  /// certified-assets sync plugin does for a directory holding only index.html.
  /// Meant for a freshly (re)installed canister, i.e. one without assets.
  public func uploadDefaultPage(cid : Principal) : async* () {
    let assets = getAssetActor(cid);
    let page = Text.encodeUtf8(getDefaultPage(cid));
    let session_id = switch (await assets.start_sync()) {
      case (#Started { session_id }) session_id;
      case (#Busy _) throw Error.reject("assets canister is busy with another sync");
    };
    let chunkIds = await assets.upload_chunks({ session_id; chunks = [page] });
    if (chunkIds.size() != 1) throw Error.reject("upload_chunks returned unexpected chunk ids");
    let sha256 = Sha256.fromBlob(#sha256, page);
    ignore await assets.execute_operations({
      session_id;
      is_final = true;
      operations = [
        #CreateAsset { key = "/index.html"; content_type = "text/html"; headers = [] },
        #SetAssetContent {
          key = "/index.html";
          encoding = #Identity;
          chunk_ids = chunkIds;
          sha256;
          chunk_sha256 = [sha256];
        },
        // clean-URL rules the sync plugin synthesizes for /index.html
        #SetRedirectRules {
          rules = [
            { from = #Exact "/"; to = "/index.html"; status = 200; headers = [] },
            { from = #Exact "/index"; to = "/"; status = 307; headers = [] },
            { from = #Exact "/index.html"; to = "/"; status = 307; headers = [] },
          ];
        },
      ];
    });
  };

  public func getDefaultPage(cid : Principal) : Text = "<!DOCTYPE html>
<html lang=\"en\">
<head>
    <meta charset=\"UTF-8\">
    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">
    <title>Hosted via hosty.live</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        .container {
            text-align: center;
            padding: 2rem;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        }
        h1 {
            font-size: 3rem;
            margin-bottom: 1rem;
            font-weight: 300;
        }
        p {
            font-size: 1.2rem;
            opacity: 0.9;
            margin-bottom: 2rem;
        }
        .canister-id {
            font-family: 'Monaco', 'Menlo', monospace;
            background: rgba(0, 0, 0, 0.2);
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-size: 0.9rem;
            word-break: break-all;
        }
    </style>
</head>
<body>
    <div class=\"container\">
        <h1>🚀 Hosted via hosty.live</h1>
        <p>Your canister is ready for deployment!</p>
        <div class=\"canister-id\">" # Principal.toText(cid) # "</div>
    </div>
</body>
</html>";

  // sha256 of HOSTY_ASSETS_MODULE (canisters/certified-assets, make release)
  public let HOSTY_ASSETS_MODULE_HASH : Blob = "\c0\be\4f\ae\73\5b\16\3c\80\eb\21\22\6c\be\0f\ef\9e\c9\12\ff\97\68\7f\2b\ec\66\34\c5\b5\ab\50\68";
  
  public let HOSTY_ASSETS_MODULE : Blob = "\1f\8b\08\00\00\00\00\00\02\03\ec\bd\0b\60\1c\57\75\3f\3c\af\dd\99\9d\d9\c7\e8\fd\96\ee\ee\ca\b2\1e\18\42\08\76\30\8f\32\69\13\08\a1\84\52\4a\69\1b\c7\96\6d\25\b6\e2\f8\a9\bc\20\d8\4a\e2\10\03\a6\18\30\c5\b4\a6\28\60\40\14\03\a6\18\30\d4\80\92\98\22\52\d3\8a\e2\50\01\86\da\d8\26\0a\38\b6\70\9c\44\01\87\7c\e7\9c\7b\67\ee\ac\76\25\ed\4a\7c\0d\fe\b7\4a\bc\7b\e7\ce\9d\73\cf\eb\77\ee\b9\67\76\67\95\ee\4d\37\ab\8a\a2\a8\47\f4\57\2d\53\94\65\8a\ba\05\fe\6d\5e\a6\6e\51\e0\1f\1c\c0\0b\1e\a9\77\2e\d3\b6\40\1f\bc\40\27\be\6e\5e\a6\6f\c1\1e\7c\85\2e\7a\db\bc\cc\d8\42\9d\f4\06\bd\fc\7d\f3\b2\c8\16\de\cf\df\e1\44\74\8b\e8\11\0d\e8\32\b7\f8\7d\7e\0b\3a\ad\2d\41\6f\6c\8b\6c\db\5b\42\07\8e\3c\c0\4b\e2\a1\43\38\9b\da\92\fb\07\23\04\a5\cd\9b\37\fb\f3\6f\e6\2c\8b\e3\cd\42\ae\cd\fc\95\8b\b5\99\b3\bf\59\30\bd\79\4b\d0\d8\cc\05\46\6a\38\60\33\a9\69\33\bd\90\ae\36\93\ae\36\13\cd\cd\5c\2b\9b\b9\32\36\0b\0d\f2\4b\37\13\43\da\96\77\e0\cb\9d\48\f3\4e\62\57\25\02\74\89\46\23\36\f3\0e\9a\17\5e\71\4c\64\b3\a0\45\34\d4\77\a8\ef\58\a6\de\a9\de\a9\1d\36\3b\f5\d5\2b\2e\a9\58\df\b3\f1\86\75\1b\6f\ee\5e\bb\a2\67\e9\8a\75\b7\ac\ed\eb\d9\a8\44\f0\8c\7d\f3\a6\1b\97\6e\ec\e9\ed\59\d1\a7\98\d8\51\c5\3b\d6\af\b9\63\e9\ca\ee\be\ee\a5\dd\eb\d7\f7\ac\5d\c9\cf\c5\82\73\8a\82\c7\89\4d\7d\dd\cb\d7\f4\2c\bc\6c\e9\a6\d5\6f\eb\51\b4\dc\be\1b\37\ae\bb\4d\b9\2c\b7\6f\63\4f\f7\4a\e5\e5\d8\97\0c\fa\6e\db\b8\ba\af\87\77\1a\7d\1b\bb\d7\f3\b9\ca\7b\d6\de\ba\f4\d6\ee\8d\f0\6f\cd\2d\3d\7c\02\ab\c0\89\15\eb\d6\df\a1\b8\74\62\45\cf\c6\be\d5\37\ac\ee\59\c9\39\df\d4\23\44\4a\21\db\2b\ba\d7\ac\e9\d9\c8\e9\a8\93\7b\89\88\8d\bd\65\3e\f5\b5\dd\37\8b\59\8d\fc\7e\1a\9f\a0\7e\a4\d2\bd\f1\46\31\65\40\3d\b7\5f\d2\2f\5f\d1\bd\76\f5\a6\3e\e4\a4\67\cd\0d\a1\0b\26\9d\90\57\24\fc\99\c9\6e\7c\70\62\f5\26\38\5c\db\b7\71\1d\b2\cf\f5\52\21\2d\b9\14\9b\92\f4\e4\33\92\76\2a\74\66\c5\ba\95\62\7c\2d\e7\99\6b\73\45\77\5f\cf\d2\f5\1b\7b\36\f5\f8\93\57\e5\9d\96\53\e5\9f\93\93\55\d3\dc\77\ac\58\d3\b3\09\e6\bc\e1\